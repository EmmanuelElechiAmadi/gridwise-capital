# ── Telegram Notifications (optional) ──────────────────────────────
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Bridge IP (optional override for config.py) ───────────────────
# BRIDGE_URL=http://192.168.1.100:5000

# ── Email (optional override for config.py) ──────────────────────
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password
# EMAIL_TO=recipient@example.com
# EMAIL_ENABLED=true

# ── Yahoo Finance symbol (optional override) ─────────────────────
# YAHOO_SYMBOL=GC=F

# ── ML (optional override) ───────────────────────────────────────
# ML_ENABLED=false

# ── Kronos foundation model (optional override) ───────────────────
# KRONOS_ENABLED=true
# KRONOS_BREAKOUT_ENABLED=false

# ── Autonomous research loop (InsightForge for Quant) ─────────────
# RESEARCH_ENABLED=false
# RESEARCH_INTERVAL_MINUTES=120
# RESEARCH_MAX_BARS=1500
# RESEARCH_PROBE_LIMIT=2
# RESEARCH_TOP_N=3
# RESEARCH_SYMBOLS=GC=F,SI=F,CL=F
# RESEARCH_AUTO_APPROVE_CYCLES=0
# RESEARCH_LLM_ENABLED=false

# ── LLM narrative layer (optional) ─────────────────────────────────
# LLM_PROVIDER=openai          # or anthropic
# LLM_API_KEY=sk-...
# LLM_FAST_MODEL=gpt-4o-mini
# LLM_CAPABLE_MODEL=claude-3-5-sonnet-latest

# ── Consensus engine (v3) ──────────────────────────────────────────
# CONSENSUS_DIRECTION_THRESHOLD=0.2

# ── Deployment quality gates (v3) ──────────────────────────────────
# DEPLOY_MIN_TRADES=30
# DEPLOY_MIN_SHARPE=0.8
# DEPLOY_MIN_OOS_CONSISTENCY=0.6
# DEPLOY_MIN_MC_PROB_PROFIT=60.0
# DEPLOY_MIN_Q_RICE=0.03
# DEPLOY_MAX_DRAWDOWN_PCT=20.0

# ── Execution layer (v3) ───────────────────────────────────────────
# EXEC_MIN_CONSENSUS_STRENGTH=0.35
# EXEC_MAX_RISK_PER_TRADE=0.02
# SHADOW_MIN_TRADES=20
# SHADOW_MIN_SHARPE=0.6
# SHADOW_MIN_MC_PROB=55.0
# EXEC_KILL_MAX_DRAWDOWN_PCT=15.0
# EXEC_KILL_CONSENSUS_COLLAPSE=true
# EXEC_KILL_CONSENSUS_FLOOR=0.15
# EXEC_KILL_REGIME_FLIP=true